<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Extensión de la vista de producto para campos de autopartes -->
    <record id="view_product_template_form_autoparts" model="ir.ui.view">
        <field name="name">product.template.form.autoparts</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <!-- Añadir campos de autopartes debajo de barcode en la información general del producto -->
            <xpath expr="//field[@name='barcode']" position="after">
                <field name="autopart_oem_code"/>
                <field name="autopart_side"/>
                <field name="autopart_quality"/>
                <field name="autopart_universal"/>
            </xpath>

            <!-- Mantener notas de autoparte en un bloque separado -->
            <xpath expr="//sheet//group[1]" position="after">
                <group string="Notas de autoparte">
                    <field name="autopart_notes" colspan="4"/>
                </group>
            </xpath>

            <!-- Añadir pestaña de compatibilidades después de las secciones de ventas e inventario -->
            <xpath expr="//notebook/page[last()]" position="after">
                <page string="Compatibilidades">
                    <field name="compatibility_ids">
                        <list string="Compatibilidades de vehículos" editable="bottom">
                            <field name="variant_id" string="Variante de Vehículo"/>
                            <field name="marca_id" string="Marca" readonly="1"/>
                            <field name="modelo_id" string="Modelo" readonly="1"/>
                            <field name="motor_id" string="Motor" optional="show" readonly="1"/>
                            <field name="active" string="Activo" widget="boolean_toggle"/>
                        </list>
                        <form string="Compatibilidad de autoparte">
                            <sheet>
                                <group>
                                    <group>
                                        <field name="variant_id" options="{'no_create': True}"/>
                                        <field name="product_tmpl_id" readonly="1" invisible="1"/>
                                    </group>
                                    <group>
                                        <field name="active" widget="boolean_toggle"/>
                                    </group>
                                </group>
                                <group string="Detalles de Aplicación">
                                    <field name="marca_id" />
                                    <field name="modelo_id" />
                                    <field name="motor_id" />
                                    <field name="fitment_notes" placeholder="Ej: Solo para modelos con transmisión manual..."/>
                                </group>
                            </sheet>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
