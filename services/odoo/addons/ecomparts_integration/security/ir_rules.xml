<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--
        Record Rule: Scope de variantes de vehiculo por proveedor (compania).

        Logica:
          - Si company_ids esta vacio (catalogo nuevo, sin scope asignado)
            la variante es visible para TODOS.
            Fallback seguro durante puesta en marcha y antes de correr
            push_vehicles con la opcion provider-id.
          - Si company_ids tiene valores, solo las companias listadas pueden
            ver y usar la variante en el selector de compatibilidades.

        Quien lo gestiona:
          El comando Django push_vehicles escribe company_ids via RPC con
          credenciales de admin. Los admin de Odoo (grupo erp_manager)
          bypassan esta regla por el comportamiento estandar de Odoo.

        Afecta:
          group_user (usuarios normales, incluyendo los proveedores).
          NO afecta a administradores Odoo ni al superuser.
    -->
    <record id="rule_vehiculo_variante_by_company" model="ir.rule">
        <field name="name">Variante vehiculo: scope por compania (proveedor)</field>
        <field name="model_id" ref="model_vehiculo_variante"/>
        <field name="domain_force">
            ['|',
             ('company_ids', '=', False),
             ('company_ids', 'in', [company_id])]
        </field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
