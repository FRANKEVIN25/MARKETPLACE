<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_ecomparts_images" model="ir.ui.view">
        <field name="name">product.template.form.ecomparts.images</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='image_1920']" position="after">
                <separator string="Galería del Marketplace"/>
                <field name="ecomparts_image_ids" widget="one2many" nolabel="1">
                    <list string="Imágenes" editable="bottom">
                        <field name="sequence" widget="handle"/>
                        <field name="image" widget="image"
                               options="{'size': [100, 100], 'zoom': true}"/>
                        <field name="name"/>
                    </list>
                </field>
            </xpath>
        </field>
    </record>
</odoo>
