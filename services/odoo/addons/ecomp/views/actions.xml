    <record id="action_autopart_compatibility" model="ir.actions.act_window">
        <field name="name">Compatibilidades de autopartes</field>
        <field name="res_model">autopart.compatibility</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
