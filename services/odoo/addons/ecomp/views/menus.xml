<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Menú raíz para Autoparts — visible para todos los usuarios internos -->
    <menuitem id="menu_autoparts_root" name="Autoparts" sequence="10"/>

    <!--
        Submenú Vehículos: solo administradores (group_erp_manager).
        Los proveedores no necesitan navegar el catálogo maestro de vehículos.
        Interactúan con variantes únicamente desde la pestaña Compatibilidades
        de su ficha de producto, donde la record rule ya filtra por su scope.
    -->
    <menuitem id="menu_vehiculo_variante"
              name="Variantes"
              parent="menu_autoparts_root"
              action="action_vehiculo_variante"
              sequence="10"
              groups="base.group_erp_manager"/>


    <!--
        Compatibilidades: visible para todos los usuarios internos.
        Permite a los proveedores revisar el listado de sus compatibilidades
        asignadas (un proveedor solo ve sus propios productos gracias al
        aislamiento de compañía estándar de Odoo en product.template).
    -->
    <menuitem id="menu_autoparts_compatibilities"
              name="Compatibilidades"
              parent="menu_autoparts_root"
              action="action_autopart_compatibility"
              sequence="20"/>
</odoo>
