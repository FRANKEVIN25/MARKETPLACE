<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        orders_odoo/views/reject_payment_wizard.xml
        Vista del wizard "Rechazar Pago" — ECOMPARTS Marketplace

        Se abre como ventana modal cuando el proveedor pulsa "Rechazar pago"
        en la pestaña Marketplace de una cotización (sale.order en draft).
    -->

    <record id="view_marketplace_reject_payment_wizard_form" model="ir.ui.view">
        <field name="name">marketplace.reject.payment.wizard.form</field>
        <field name="model">marketplace.reject.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Rechazar Comprobante de Pago">
                <group>
                    <field name="sale_order_id" readonly="1" string="Pedido"/>
                </group>
                <group>
                    <field name="rejection_reason"
                           placeholder="Explica al cliente qué debe corregir.&#10;Ej: 'El monto transferido es S/ 350, pero el pedido es S/ 472.'"
                           colspan="2"
                           rows="4"/>
                </group>
                <footer>
                    <button name="action_confirm_reject"
                            string="Confirmar Rechazo"
                            type="object"
                            class="btn-danger"
                            data-hotkey="q"/>
                    <button string="Cancelar"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
